DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Agentes IA — integrações (aba /agentes)
N8N_BASE_URL=https://n8n-production-d5ef.up.railway.app
N8N_API_KEY=
ANTHROPIC_API_KEY=
CLICKUP_API_TOKEN=
CLICKUP_API_KEY=
# Coletor read-only de /operacao: workflow n8n específico do cockpit.
N8N_OPERATION_WORKFLOW_ID=F8GWU4QxWg9hBAVQ
# Rollout reversível do cockpit; false mantém /dashboard como entrada.
NEXT_PUBLIC_OPERATION_COCKPIT_ENABLED=false
# Optional external Spy Analytics dashboard; must be an HTTPS URL without query/hash.
NEXT_PUBLIC_SPY_ANALYTICS_URL=
# Optional external Quiz Analytics dashboard; must be an HTTPS URL without query/hash.
NEXT_PUBLIC_QUIZ_ANALYTICS_URL=
# Command API do corte 2B2-B (POST /api/operacao/commands). Flag SERVER-side,
# fail-closed: ausente ou false => rota responde 404. OPERATION_COMMANDS_ENABLED
# habilita a API e o ledger; OPERATION_COMMAND_DISPATCH_ENABLED controla o envio
# e permanece false até os gates de ativação da outbox.
OPERATION_COMMANDS_ENABLED=false
OPERATION_COMMAND_DISPATCH_ENABLED=false
OPERATION_COMMAND_INTAKE_URL=
OPERATION_COMMAND_INTAKE_SECRET=
OPERATION_COMMAND_INTAKE_HOST_ALLOWLIST=
OPERATION_COMMAND_STATUS_ENABLED=false
OPERATION_COMMAND_STATUS_URL=
OPERATION_COMMAND_STATUS_SECRET=
OPERATION_COMMAND_STATUS_HOST_ALLOWLIST=
TRIAGEM_WEBHOOK_LISTAR_URL=https://n8n-production-d5ef.up.railway.app/webhook/triagem-listar
GROQ_API_KEY=
BLACK_MANUAL_WEBHOOK_URL=https://n8n-production-d5ef.up.railway.app/webhook/manual-cria-black
# Webhook n8n que notifica o #triagem-ngv quando um produto é rejeitado (Fase 2)
N8N_NOTIF_REJEICAO_WEBHOOK_URL=
OPERATION_QUIZ_ANALYTICS_ENABLED=false
OPERATION_QUIZ_ANALYTICS_SUMMARY_URL=
OPERATION_QUIZ_ANALYTICS_SUMMARY_SECRET=
OPERATION_QUIZ_ANALYTICS_HOST_ALLOWLIST=
# Módulo /sistemas/quiz (Fase 2, ADR docs/NGV-BANCO-MODULOS-FUNDACAO-ADR.md). Rollback:
# ausente/false mantém a rota no EmptyState da Fase 1 e nunca chama o Quiz.
SISTEMAS_QUIZ_MODULE_ENABLED=false
# Basic Auth do painel do Quiz (hasDashboardAuthorization em quiz-analytics/server.js).
# Server-side apenas — nunca NEXT_PUBLIC_*, nunca digitada pelo operador de novo.
QUIZ_DASHBOARD_USERNAME=
QUIZ_DASHBOARD_PASSWORD=
# Read-only aggregate Spy Analytics summary; server-side and fail-closed by default.
OPERATION_SPY_ANALYTICS_ENABLED=false
OPERATION_SPY_ANALYTICS_SUMMARY_URL=
OPERATION_SPY_ANALYTICS_SUMMARY_SECRET=
OPERATION_SPY_ANALYTICS_HOST_ALLOWLIST=
# Módulo /sistemas/spy (Fase 3, somente leitura, ADR docs/NGV-BANCO-MODULOS-FUNDACAO-ADR.md).
# Rollback: ausente/false mantém a rota no EmptyState e nunca chama o Spy. Capacidade `mutate`
# do módulo segue com allowlist vazia — nenhuma mutação (registrar/editar/apagar leitura,
# cadastrar/remover oferta) existe nesta fase.
SISTEMAS_SPY_MODULE_ENABLED=false
# Senha compartilhada do time pro login do Spy (POST /api/auth em workspaces/spy-analytics/api/
# auth.js) — o adapter reautentica a cada leitura pra obter o cookie de sessão. Server-side
# apenas — nunca NEXT_PUBLIC_*, nunca a mesma senha de outro fluxo.
SPY_DASHBOARD_PASSWORD=
# Leitura agregada do NGV Core no Dashboard e em /operacao. Server-side e
# fail-closed: ausente ou false não envia chave nem faz requisição externa.
OPERATION_NGV_CORE_SUMMARY_ENABLED=false
# Mostra no cockpit a saúde/freshness por fonte retornada pelo Core. Não muda
# autoridade do Neon, nem habilita comandos ou escrita. Rollback: false/ausente.
OPERATION_CORE_SOURCE_STATE_ENABLED=false
# Módulos transversais do cockpit. Apenas leitura local; não expor com
# NEXT_PUBLIC e não habilitar sem os readbacks externos correspondentes.
OPERATION_EXECUTION_MODULE_ENABLED=false
OPERATION_DEPLOYMENT_DOMAINS_MODULE_ENABLED=false
# Resumo privado de evidências de ciclo de vida das ofertas no NGV Core. A
# chave é exclusiva de leitura do Banco, server-side e default-off; nunca use
# NEXT_PUBLIC_ nem reutilize uma chave de ingress/writer.
OPERATION_LIFECYCLE_EVIDENCE_ENABLED=false
NGV_CORE_LIFECYCLE_SUMMARY_URL=
NGV_CORE_LIFECYCLE_READER_KEY=
# Resumo agregado de comércio por oferta. Credencial dedicada somente para
# leitura do Banco, server-side e default-off; não reutilizar chave de writer
# nem prefixar com NEXT_PUBLIC.
OPERATION_COMMERCE_READBACK_ENABLED=false
NGV_CORE_COMMERCE_SUMMARY_URL=
NGV_CORE_COMMERCE_SUMMARY_READER_KEY=
# Emissor agregado diário para o NGV Core (Supabase Edge Function
# POST banco-global-daily-ingest). Payload sem PII (contagens + timestamps).
# WRITER_KEY ausente => rota responde 503 antes de tocar banco/rede.
NGV_CORE_URL=
# Preferida para o Banco NGV; a chave genérica abaixo é só compatibilidade legado.
# Também é a credencial de ingress do lookup de Apps Admin (header x-ngv-core-key);
# a credencial do Core é POR SISTEMA — nunca reaproveite a de outro sistema aqui.
NGV_CORE_BANCO_WRITER_KEY=
NGV_CORE_WRITER_KEY=
NGV_CORE_HOST_ALLOWLIST=
# Lookup de acesso do cliente por e-mail (GET /api/admin/apps/lookup) lendo do NGV Core:
# https://<project>.supabase.co/functions/v1/apps-lookup-read
# Server-side e fail-closed: URL ausente, fora da allowlist de host ou sem
# NGV_CORE_BANCO_WRITER_KEY faz a rota responder 503 sem tocar a rede.
NGV_CORE_APPS_LOOKUP_URL=
